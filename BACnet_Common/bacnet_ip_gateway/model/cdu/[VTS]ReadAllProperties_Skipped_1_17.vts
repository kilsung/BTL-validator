	Service = ReadProperty
	InvokeID = 1
	SegMsg = 0
	SegResp = 0
	MaxResp = 1476
	Object = 0, OBJECT1
	Property = 1, object-name
    )

    EXPECT (
	NETWORK = ACTIVENET
	SA = IUT_ADDR
	DER = FALSE
	BVLCI = ORIGINAL-UNICAST-NPDU
	PDU = ComplexAck
	Service = ReadProperty
	Object = 0, OBJECT1
	Property = 1, object-name
	OpenTag 3
